{
  "name": "dsh-myinfo",
  "version": "0.4.4",
  "description": "Personal profile manager for DeepSeek Harness: identity, career with salary, relationships, dated reflections, and an asset ledger. Apple-styled main panel + right dock tab + floating asset overlay + agent tools, with manual dark-mode switch; all local-only.",
  "type": "module",
  "license": "MIT",
  "author": "simonxluo",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "myinfo",
    "profile",
    "assets"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "store.js",
    "tools.js",
    "panel.js",
    "ids.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "test/host.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs"
  }
}
